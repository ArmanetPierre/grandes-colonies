{
  "name": "grand-colonies",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p packages/engine && tsc --noEmit -p packages/protocol && tsc --noEmit -p packages/server && tsc --noEmit -p packages/client && tsc --noEmit -p packages/sim && tsc --noEmit -p apps/host && tsc --noEmit -p tsconfig.scripts.json",
    "dev:server": "tsx packages/server/src/dev.ts",
    "dev:client": "vite --config packages/client/vite.config.ts packages/client",
    "host": "tsx apps/host/src/main.ts",
    "assets": "node scripts/assets.mjs",
    "play": "node scripts/play.mjs",
    "build": "vite build --config packages/client/vite.config.ts packages/client",
    "start": "tsx apps/host/src/main.ts"
  },
  "dependencies": {
    "tsx": "^4.23.12"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "^0.185.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.0"
  }
}
