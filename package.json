{
  "name": "grand-colonies",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build --force",
    "dev:server": "tsx packages/server/src/dev.ts",
    "dev:client": "vite --config packages/client/vite.config.ts packages/client",
    "host": "tsx apps/host/src/main.ts",
    "play": "node scripts/play.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.23.12",
    "typescript": "^5.6.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.0"
  }
}
